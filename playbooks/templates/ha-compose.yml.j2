services:
  home-assistant:
    image: ghcr.io/home-assistant/home-assistant:{{ ha_version }}
    restart: unless-stopped
    # Reason: host network finds the speaker on the LAN and reaches the bridge on localhost.
    network_mode: host
    volumes:
      - ./config:/config
    environment:
      TZ: "{{ timezone }}"
  wyoming-openai:
    # Bridges Home Assistant's Wyoming protocol to Speaches (step 4).
    image: ghcr.io/roryeckel/wyoming_openai:{{ wyoming_openai_version }}
    restart: unless-stopped
    network_mode: host
    environment:
      WYOMING_URI: tcp://127.0.0.1:10300
      WYOMING_LANGUAGES: en
      STT_BACKEND: SPEACHES
      STT_OPENAI_URL: http://127.0.0.1:8001/v1
      STT_MODELS: "{{ whisper_model }}"
      TTS_BACKEND: SPEACHES
      TTS_OPENAI_URL: http://127.0.0.1:8001/v1
      TTS_MODELS: "{{ kokoro_model }}"
      TTS_VOICES: "{{ kokoro_voice }}"
