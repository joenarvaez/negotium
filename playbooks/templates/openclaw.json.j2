{
  "gateway": {
    "mode": "local",
    "bind": "tailnet",
    "port": 18789,
    "trustedProxies": ["127.0.0.1"],
    "auth": { "mode": "token", "token": "${OPENCLAW_GATEWAY_TOKEN}" },
    "http": { "endpoints": { "chatCompletions": { "enabled": true }, "responses": { "enabled": true } } }
  },
  "mcp": {
    "servers": {
      "home_assistant": {
        "url": "http://127.0.0.1:8123/api/mcp",
        "transport": "streamable-http",
        "headers": { "Authorization": "Bearer ${HA_TOKEN}" }
      }
    }
  },
  "models": {
    "providers": {
      "litellm": {
        "baseUrl": "http://{{ tailscale_ip }}:4000",
        "apiKey": "${LITELLM_API_KEY}",
        "api": "openai-completions",
        "models": [
          { "id": "qwen", "name": "Qwen", "input": ["text"], "contextWindow": 131072, "maxTokens": 8192 },
          { "id": "qwen_fast", "name": "Qwen Fast", "input": ["text"], "contextWindow": 131072, "maxTokens": 8192 },
          { "id": "strata", "name": "Strata", "input": ["text"], "contextWindow": 32768, "maxTokens": 8192 }
        ]
      }
    }
  },
  "plugins": {
    "entries": {
      "voice-call": {
        "enabled": true,
        "config": {
          "provider": "twilio",
          "fromNumber": "${TWILIO_FROM_NUMBER}",
          "toNumber": "${PERSONAL_MOBILE_NUMBER}",
          "twilio": { "accountSid": "${TWILIO_ACCOUNT_SID}", "authToken": "${TWILIO_AUTH_TOKEN}" },
          "serve": { "port": 3334, "path": "/voice/webhook" },
          "publicUrl": "https://{{ tailscale_hostname }}:10000/voice/webhook",
          "webhookSecurity": { "allowedHosts": ["{{ tailscale_hostname }}"], "trustedProxyIPs": ["127.0.0.1"] },
          "outbound": { "defaultMode": "conversation" },
          "streaming": {
            "enabled": true,
            "provider": "deepgram",
            "streamPath": "/voice/stream",
            "providers": { "deepgram": { "apiKey": "${DEEPGRAM_API_KEY}", "model": "nova-3", "endpointingMs": 800, "language": "en-US" } }
          },
          "tts": {
            "provider": "openai",
            "providers": {
              "openai": {
                "apiKey": "local",
                "baseUrl": "http://127.0.0.1:8001/v1",
                "model": "{{ kokoro_model }}",
                "speakerVoice": "{{ kokoro_voice }}"
              }
            }
          },
          "agentId": "phone",
          "sessionScope": "per-call",
          "responseTimeoutMs": 60000,
          "maxDurationSeconds": 7200,
          "staleCallReaperSeconds": 7200,
          "transcriptTimeoutMs": 3600000
        }
      }
    }
  },
  "agents": {
    "defaults": { "model": { "primary": "litellm/qwen" } },
    "entries": {
      "main": {
        "tools": { "deny": ["voice-call"] },
        "subagents": { "allowAgents": ["phone"] }
      },
      "phone": {
        "name": "Phone",
        "workspace": "/home/node/.openclaw/workspace-phone",
        "model": "litellm/qwen_fast",
        "skills": [],
        "tools": { "allow": ["voice-call", "exec"], "exec": { "mode": "allowlist" } }
      }
    }
  }
}
