services:
  openclaw:
    image: ghcr.io/openclaw/openclaw:{{ openclaw_version }}
    restart: unless-stopped
    # Reason: host network reaches LiteLLM, Home Assistant and speech on the box.
    network_mode: host
    init: true
    environment:
      HOME: /home/node
      OPENCLAW_STATE_DIR: /home/node/.openclaw
      OPENCLAW_CONFIG_PATH: /home/node/.openclaw/openclaw.json
      OPENCLAW_GATEWAY_TOKEN: "{{ openclaw_gateway_token }}"
      LITELLM_API_KEY: "{{ litellm_master_key }}"
      HA_TOKEN: "{{ ha_openclaw_token }}"
      TWILIO_ACCOUNT_SID: "{{ twilio_account_sid }}"
      TWILIO_AUTH_TOKEN: "{{ twilio_auth_token }}"
      TWILIO_FROM_NUMBER: "{{ twilio_phone_number }}"
      PERSONAL_MOBILE_NUMBER: "{{ personal_mobile_number }}"
      TZ: "{{ timezone }}"
    volumes:
      - ./state:/home/node/.openclaw
      # The health coach reads vitals here; the vitals receiver (step 7) owns them.
      - {{ docker_dir }}/vitals/data:/home/node/.openclaw/workspace/health/vitals:ro
    command: ["node", "dist/index.js", "gateway", "--port", "18789"]
