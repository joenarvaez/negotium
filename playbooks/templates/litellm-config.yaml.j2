model_list:
  - model_name: qwen
    litellm_params:
      model: openai/{{ qwen_model }}
      api_base: {{ dashscope_base_url }}
      api_key: os.environ/DASHSCOPE_API_KEY
  - model_name: strata
    litellm_params:
      model: openai/{{ strata_model }}
      api_base: http://127.0.0.1:8090/v1
      api_key: os.environ/STRATA_API_KEY

guardrails:
  - guardrail_name: presidio-pii
    litellm_params:
      guardrail: presidio
      mode: pre_call
      default_on: true
      output_parse_pii: true
      # Reason: the default scope "both" re-masks replies right after output_parse_pii restores them.
      presidio_filter_scope: input
      # Reason: places and dates don't identify you, and masking them breaks everyday questions.
      presidio_entities_deny_list: {{ pii_entities_not_masked | to_json }}
      presidio_analyzer_api_base: http://127.0.0.1:5002
      presidio_anonymizer_api_base: http://127.0.0.1:5001

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
