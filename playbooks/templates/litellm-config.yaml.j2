model_list:
  - model_name: deepseek
    litellm_params:
      model: deepseek/{{ deepseek_model }}
      api_key: os.environ/DEEPSEEK_API_KEY
  - model_name: deepseek_fast
    litellm_params:
      model: deepseek/{{ deepseek_fast_model }}
      api_key: os.environ/DEEPSEEK_API_KEY
  - model_name: qwen_fast
    litellm_params:
      model: openai/{{ qwen_fast_model }}
      api_base: {{ dashscope_base_url }}
      api_key: os.environ/DASHSCOPE_API_KEY
  - model_name: qwen
    litellm_params:
      model: openai/{{ qwen_model }}
      api_base: {{ dashscope_base_url }}
      api_key: os.environ/DASHSCOPE_API_KEY
  - model_name: local
    litellm_params:
      model: ollama_chat/{{ local_llm_name }}
      api_base: http://{{ ollama_host }}

guardrails:
  - guardrail_name: presidio-pii
    litellm_params:
      guardrail: presidio
      mode: pre_call
      default_on: true
      output_parse_pii: true
      # Reason: the default scope "both" re-masks replies right after output_parse_pii restores them.
      presidio_filter_scope: input
      # Reason: places and dates don't identify you, and masking them breaks everyday questions.
      presidio_entities_deny_list: {{ pii_entities_not_masked | to_json }}
      presidio_analyzer_api_base: http://127.0.0.1:5002
      presidio_anonymizer_api_base: http://127.0.0.1:5001

router_settings:
  # Reason: Goose asks for its built-in fast model by this name; send it to DeepSeek (system_adr.md §4).
  model_group_alias:
    gpt-4o-mini: deepseek_fast

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
