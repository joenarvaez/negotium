model_list:
  - model_name: strata
    litellm_params:
      model: openai/{{ strata_model }}
      api_base: http://127.0.0.1:8090/v1
      api_key: os.environ/STRATA_API_KEY

guardrails:
  - guardrail_name: presidio-pii
    litellm_params:
      guardrail: presidio
      mode: pre_call
      default_on: true
      output_parse_pii: true
      presidio_analyzer_api_base: http://127.0.0.1:5002
      presidio_anonymizer_api_base: http://127.0.0.1:5001

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
