services:
  litellm:
    image: ghcr.io/berriai/litellm:{{ litellm_version }}
    restart: unless-stopped
    # Reason: host network reaches Strata, Ollama and Presidio on localhost.
    network_mode: host
    environment:
      STRATA_API_KEY: "{{ strata_api_key }}"
      DASHSCOPE_API_KEY: "{{ dashscope_api_key }}"
      LITELLM_MASTER_KEY: "{{ litellm_master_key }}"
    volumes:
      - ./config.yaml:/app/config.yaml:ro
      # PR #32014: phone numbers and names in tool calls come back unmasked.
      - ./presidio.py:/app/.venv/lib/python3.13/site-packages/litellm/proxy/guardrails/guardrail_hooks/presidio.py:ro
    command: ["--config", "/app/config.yaml", "--host", "{{ tailscale_ip }}", "--port", "4000"]
