# Sets up Home Assistant through its own API. Runs inside the HA container (it has aiohttp).
# Idempotent; prints {"changed": bool}.
#   core     — onboarding, Wyoming speech, MCP server + a token for OpenClaw (step 5)
#   fallback — unmatched commands go to OpenClaw (step 6, once OpenClaw is up)
import asyncio
import json
import os
import sys

import aiohttp

BASE = "http://127.0.0.1:8123"
CLIENT_ID = BASE + "/"
USER = "{{ ha_owner_username }}"
PASSWORD = os.environ["HA_OWNER_PASSWORD"]
OPENCLAW_TOKEN_FILE = "/config/.openclaw_token"


async def get_token(s, done):
    if "user" not in done:
        r = await s.post(f"{BASE}/api/onboarding/users", json={
            "client_id": CLIENT_ID, "name": "{{ ha_owner_name }}", "username": USER,
            "password": PASSWORD, "language": "en"})
        code = (await r.json())["auth_code"]
    else:
        r = await s.post(f"{BASE}/auth/login_flow", json={
            "client_id": CLIENT_ID, "handler": ["homeassistant", None], "redirect_uri": CLIENT_ID})
        flow_id = (await r.json())["flow_id"]
        r = await s.post(f"{BASE}/auth/login_flow/{flow_id}", json={
            "client_id": CLIENT_ID, "username": USER, "password": PASSWORD})
        code = (await r.json())["result"]
    r = await s.post(f"{BASE}/auth/token", data={
        "grant_type": "authorization_code", "code": code, "client_id": CLIENT_ID})
    return (await r.json())["access_token"]


async def ws_call(ws, n, msg):
    await ws.send_json({"id": n, **msg})
    reply = await ws.receive_json()
    assert reply["success"], reply
    return reply["result"]


async def add_entry(s, auth, handler, *steps):
    """Adds an integration unless present; each dict in steps answers one form."""
    entries = await (await s.get(f"{BASE}/api/config/config_entries/entry", headers=auth)).json()
    found = next((e for e in entries if e["domain"] == handler), None)
    if found:
        return found["entry_id"], False
    r = await s.post(f"{BASE}/api/config/config_entries/flow", json={"handler": handler}, headers=auth)
    flow_id = (await r.json())["flow_id"]
    for data in steps:
        r = await s.post(f"{BASE}/api/config/config_entries/flow/{flow_id}", json=data, headers=auth)
        result = await r.json()
    assert result.get("type") == "create_entry", result
    return result["result"]["entry_id"], True


async def open_ws(s, token):
    ws = await s.ws_connect(f"{BASE}/api/websocket")
    await ws.receive_json()
    await ws.send_json({"type": "auth", "access_token": token})
    await ws.receive_json()
    return ws


async def preferred_pipeline(ws, n):
    pipelines = await ws_call(ws, n, {"type": "assist_pipeline/pipeline/list"})
    return next(x for x in pipelines["pipelines"] if x["id"] == pipelines["preferred_pipeline"])


async def update_pipeline(ws, n, p, **fields):
    update = {k: v for k, v in p.items() if k != "id"}
    update.update(fields)
    await ws_call(ws, n, {"type": "assist_pipeline/pipeline/update", "pipeline_id": p["id"], **update})


async def core(s, token, done):
    changed = False
    auth = {"Authorization": f"Bearer {token}"}
    for step, body in [("user", None), ("core_config", {}), ("analytics", {}),
                       ("integration", {"client_id": CLIENT_ID, "redirect_uri": CLIENT_ID})]:
        if step not in done:
            changed = True
            if body is not None:
                await s.post(f"{BASE}/api/onboarding/{step}", json=body, headers=auth)

    _, added = await add_entry(s, auth, "wyoming", {"host": "127.0.0.1", "port": 10300})
    changed |= added
    # Reason: OpenClaw controls the house through HA's MCP server (/api/mcp).
    _, added = await add_entry(s, auth, "mcp_server", {})
    changed |= added

    ws = await open_ws(s, token)

    if not os.path.exists(OPENCLAW_TOKEN_FILE):
        long_lived = await ws_call(ws, 200, {"type": "auth/long_lived_access_token",
                                             "client_name": "openclaw", "lifespan": 3650})
        with open(OPENCLAW_TOKEN_FILE, "w") as f:
            f.write(long_lived)
        os.chmod(OPENCLAW_TOKEN_FILE, 0o600)
        changed = True

    # Reason: the Wyoming entities appear a moment after the entry is created.
    for _ in range(30):
        ents = await ws_call(ws, 1 + _, {"type": "config/entity_registry/list"})
        wyoming = [e["entity_id"] for e in ents if e["platform"] == "wyoming"]
        stt = next((e for e in wyoming if e.startswith("stt.")), None)
        tts = next((e for e in wyoming if e.startswith("tts.")), None)
        if stt and tts:
            break
        await asyncio.sleep(1)
    assert stt and tts, wyoming

    p = await preferred_pipeline(ws, 100)
    if p["stt_engine"] != stt or p["tts_engine"] != tts:
        await update_pipeline(ws, 101, p, stt_engine=stt, stt_language="en", tts_engine=tts,
                              tts_language="en", tts_voice="{{ kokoro_voice }}")
        changed = True
    return changed


async def fallback(s, token):
    changed = False
    auth = {"Authorization": f"Bearer {token}"}
    # Reason: HA's LiteLLM integration is a plain OpenAI-compatible client; OpenClaw speaks that API.
    entry_id, changed = await add_entry(s, auth, "litellm", {
        "url": "http://127.0.0.1:18789", "api_key": os.environ["OPENCLAW_GATEWAY_TOKEN"]})
    entries = await (await s.get(f"{BASE}/api/config/config_entries/entry", headers=auth)).json()
    if next(e for e in entries if e["entry_id"] == entry_id)["num_subentries"] == 0:
        r = await s.post(f"{BASE}/api/config/config_entries/subentries/flow",
                         json={"handler": [entry_id, "conversation"]}, headers=auth)
        flow_id = (await r.json())["flow_id"]
        # Reason: no HA tools here; OpenClaw controls the house through HA's MCP server.
        r = await s.post(f"{BASE}/api/config/config_entries/subentries/flow/{flow_id}",
                         json={"model": "openclaw/default", "llm_hass_api": []}, headers=auth)
        result = await r.json()
        assert result.get("type") == "create_entry", result
        changed = True
    ws = await open_ws(s, token)
    for n in range(30):
        ents = await ws_call(ws, 300 + n, {"type": "config/entity_registry/list"})
        agent = next((e["entity_id"] for e in ents
                      if e["platform"] == "litellm" and e["entity_id"].startswith("conversation.")), None)
        if agent:
            break
        await asyncio.sleep(1)
    assert agent, "no OpenClaw conversation agent"
    p = await preferred_pipeline(ws, 400)
    if p["conversation_engine"] != agent or not p.get("prefer_local_intents"):
        await update_pipeline(ws, 401, p, conversation_engine=agent, prefer_local_intents=True)
        changed = True
    return changed


async def main():
    async with aiohttp.ClientSession() as s:
        r = await s.get(f"{BASE}/api/onboarding")
        # Reason: once onboarding is finished, HA stops serving this endpoint after a restart.
        done = ({"user", "core_config", "analytics", "integration"} if r.status == 404
                else {x["step"] for x in await r.json() if x["done"]})
        token = await get_token(s, done)
        if sys.argv[1] == "core":
            changed = await core(s, token, done)
        else:
            changed = await fallback(s, token)
    print(json.dumps({"changed": changed}))


asyncio.run(main())
